# Required - from your own Azure app registration (Entra admin center →
# App registrations → your app → Overview → "Application (client) ID").
# This is NOT a secret and is safe to store as a plain env var.
AZURE_CLIENT_ID=replace-with-your-application-client-id

# No AZURE_CLIENT_SECRET and no AZURE_TENANT_ID needed - the app
# registration uses "Allow public client flows" (PKCE) instead of a
# secret, and the authority stays "common" so no tenant ID is hardcoded.

# Required
SESSION_SECRET=replace-with-a-long-random-string
PUBLIC_URL=https://your-app-name.onrender.com

# Optional simple shared access gate (leave blank to disable)
SITE_PASSWORD=

# Set to true when deployed on Render/HTTPS, false for local http testing
COOKIE_SECURE=true

PORT=3000
